# Database Configuration
# PostgreSQL is required (no SQLite support)
# For Docker development:
DATABASE_URL=postgresql://stocksuser:stockspass@db:5432/stocks_alert
# For local PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/stocks_alert

# Email Configuration (SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True

# JWT Secret Key (generate a secure random key for production)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Twilio Configuration (for WhatsApp alerts)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Chrome/Selenium Configuration (automatically set in Docker)
# Leave empty for local development, Docker will set these automatically
CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Application Settings
PYTHONUNBUFFERED=1

